{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CSFWorkbook",
  "description": "Cloud Sovereignty Framework (CSF) Self-Assessment Workbook Schema (v2.0)",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0",
      "default": "2.0"
    },
    "meta": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version",
        "title"
      ],
      "additionalProperties": false
    },
    "frontSheet": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "sealLevels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seal": {
            "type": "number",
            "enum": [
              0,
              1,
              2,
              3,
              4
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "seal",
          "name",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "strata": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "critical": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "assessed",
              "third-party"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "questions": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scope": {
                      "type": "string",
                      "const": "party"
                    },
                    "axis": {
                      "type": "string",
                      "enum": [
                        "assessment",
                        "party"
                      ],
                      "default": "assessment"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "why": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "type": "string",
                      "minLength": 1
                    },
                    "defaultMateriality": {
                      "type": "string",
                      "enum": [
                        "material",
                        "ranking",
                        "informational",
                        "na"
                      ]
                    },
                    "ladder": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "description": {
                            "type": "string",
                            "minLength": 1
                          },
                          "points": {
                            "type": "number",
                            "minimum": 0
                          },
                          "seal": {
                            "$ref": "#/properties/sealLevels/items/properties/seal"
                          }
                        },
                        "required": [
                          "id",
                          "description",
                          "points",
                          "seal"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "id",
                    "scope",
                    "text",
                    "role",
                    "defaultMateriality",
                    "ladder"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scope": {
                      "type": "string",
                      "const": "dimension"
                    },
                    "appliesTo": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "why": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "type": "string",
                      "minLength": 1
                    },
                    "defaultMateriality": {
                      "$ref": "#/properties/objectives/items/properties/questions/items/anyOf/0/properties/defaultMateriality"
                    },
                    "ladder": {
                      "type": "array",
                      "items": {
                        "$ref": "#/properties/objectives/items/properties/questions/items/anyOf/0/properties/ladder/items"
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "id",
                    "scope",
                    "appliesTo",
                    "text",
                    "role",
                    "defaultMateriality",
                    "ladder"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "name",
          "weight",
          "questions"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "testEstates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "parties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "serves": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "default": []
                }
              },
              "required": [
                "id",
                "name",
                "type"
              ],
              "additionalProperties": false
            },
            "default": []
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "questionId": {
                  "type": "string",
                  "minLength": 1
                },
                "rungId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "questionId",
                "rungId"
              ],
              "additionalProperties": false
            },
            "default": []
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "recommender": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "disclosure": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "label",
            "url"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "disclosure"
      ],
      "additionalProperties": false
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "links": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "question"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "dimension"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "objective"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1
          },
          "whenAtOrBelow": {
            "$ref": "#/properties/sealLevels/items/properties/seal"
          },
          "horizon": {
            "type": "string",
            "enum": [
              "renewal",
              "strategic"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "title",
          "action",
          "links",
          "whenAtOrBelow",
          "horizon",
          "order"
        ],
        "additionalProperties": false
      },
      "default": []
    }
  },
  "required": [
    "meta",
    "sealLevels",
    "objectives"
  ],
  "additionalProperties": false
}
